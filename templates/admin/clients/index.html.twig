{% extends 'base.html.twig' %}

{% block title %}Clients index
{% endblock %}

{% block body %}
	<div data-controller="client" class="relative overflow-x-auto shadow-md sm:rounded-lg">
		<div class="flex items-center justify-between flex-column md:flex-row flex-wrap space-y-4 md:space-y-0 p-4 bg-white dark:bg-gray-900">
			<div class="w-full flex justify-between items-center mb-5">
				<h2 class=" text-2xl font-bold text-gray-900 dark:text-white">Liste des clients</h2>
				<div class="flex gap-5">
					<a class="text-green-400 inline-flex items-center hover:text-white border border-green-400 hover:bg-green-400 first-letter:text-green-400 focus:ring-4 focus:outline-none focus:ring-green-400 font-medium rounded-lg text-sm px-2 py-1 text-center" href="{{ path('app_admin_clients_new') }}">
						<i class="bi bi-plus text-2xl mr-1"></i>
						Ajouter un client</a>
				</div>
			</div>
			<table id="table-clients" class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
				<thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
					<tr>
						<th scope="col" class="px-6 py-3">
							Name
						</th>
						<th scope="col" class="px-6 py-3">
							Téléphone
						</th>
						<th scope="col" class="px-6 py-3">
							Solde des comptes
						</th>
						<th scope="col" class="px-6 py-3">
							Status
						</th>
					</tr>
				</thead>
				<tbody>
					{% for client in clients %}
						<tr class="odd:bg-white odd:dark:bg-gray-900 even:bg-gray-50 even:dark:bg-gray-800 border-b dark:border-gray-700">
							<th scope="row" class="group flex justify-between items-center px-6 py-4 text-gray-900 whitespace-nowrap dark:text-white">
								<div class="ps-3">
									<div class="text-base font-semibold">
										{{ client.lastname }}
										{{ client.firstname }}</div>
									<div class="font-normal text-gray-500">{{ client.email }}</div>
								</div>
								<div class=" flex gap-2 ">
									<a data-modal-target='modal_edit_client' href="{{ path('app_admin_clients_edit', {id:client.id}) }}" data-id-client="{{client.id}}" class="btn-details-client transform translate-y-4 opacity-0 duration-300 ease-out group-hover:translate-y-0 transition-all group-hover:opacity-100 cursor-pointer flex w-7 h-7 items-center justify-center text-gray-600 rounded-md p-1 border border-zinc-400 hover:shadow hover:bg-zinc-50">
										<i class="bi bi-pencil-fill"></i>
									</a>
									<a data-action="click->client#openModalViewClient" data-id-client="{{client.id}}" class="btn-details-client transform translate-y-4 opacity-0 duration-300 delay-150 ease-out group-hover:translate-y-0 transition-all group-hover:opacity-100 cursor-pointer flex w-7 h-7 items-center justify-center text-gray-600 rounded-md p-1 border border-zinc-400 hover:shadow hover:bg-zinc-50">
										<i class="bi bi-three-dots text-xl"></i>
									</a>
								</div>
							</th>
							<td class="px-6 py-4">
								{{ client.phone }}
							</td>
							<td class="px-6 py-4">
								{{ client.balanceAccounts }}
								<span>€</span>
							</td>
							<td class="px-6 py-4">
								<div class="flex items-center">
									<div class="h-2.5 w-2.5 rounded-full bg-green-500 me-2"></div>
									Actif
								</div>
							</td>
						</tr>
					{% else %}
						<tr class="bg-white border-b w-full p-4 dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">

							<div class="w-full">Aucun client<div>
								{% endfor %}
							</tr>
						</tr>
					</tbody>
				</tbody>
			</table>
			{{ include('admin/clients/_modalShow.html.twig') }}
		</div>
	{% endblock %}
